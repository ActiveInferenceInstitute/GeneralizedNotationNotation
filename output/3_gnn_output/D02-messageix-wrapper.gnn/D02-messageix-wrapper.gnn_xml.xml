    <connection type="directed">
      <sources>p</sources>
      <targets>d</targets>
    </connection>
    <connection type="directed">
      <sources>s</sources>
      <targets>J</targets>
    </connection>
    <connection type="directed">
      <sources>s</sources>
      <targets>K</targets>
    </connection>
    <connection type="directed">
      <sources>s</sources>
      <targets>x</targets>
    </connection>
    <connection type="directed">
      <sources>x</sources>
      <targets>e</targets>
    </connection>
    <connection type="directed">
      <sources>x</sources>
      <targets>p</targets>
    </connection>
  </connections>
  <parameters>
    <parameter name="cap">[[200000.0]]</parameter>
    <parameter name="d">[[0.0, 0.0]]</parameter>
    <parameter name="num_commodities">2</parameter>
    <parameter name="num_regions">1</parameter>
    <parameter name="num_technologies">4</parameter>
    <parameter name="num_time_slices">12</parameter>
  </parameters>
