module Predictive_Coding_Active_Inference_Agent

// GNN Model: Predictive Coding Active Inference Agent
// A continuous predictive-coding Active Inference agent rendered as a native
// linear-Gaussian state-space model (LGSSM). The agent runs passively — it has no
// control input:
// - Hidden state mu = (mu, mu_dot): the generalized coordinates of the belief.
// - Observation y: an identity readout of both generalized coordinates.
// - F encodes the linearized dynamics f(mu): mu integrates mu_dot (dt = 0.1) and
//   mu_dot leaks toward the flow.
// - Q and R are the dynamics- and sensory-error covariances (the inverse
//   precisions of the predictive-coding formulation).
// Generated by AlloySerializer

// Variable signatures
sig F {
  value: Int,
  dimensions: seq Int  // [2, 2]
}

sig H {
  value: Int,
  dimensions: seq Int  // [2, 2]
}

sig Q {
  value: Int,
  dimensions: seq Int  // [2, 2]
}

sig R {
  value: Int,
  dimensions: seq Int  // [2, 2]
}

sig prior_cov {
  value: Int,
  dimensions: seq Int  // [2, 2]
}

sig prior_mean {
  value: Int,
  dimensions: seq Int  // [2]
}

sig t {
  value: Int,
  dimensions: seq Int  // [1]
}

sig x {
  value: Int,
  dimensions: seq Int  // [2, 1]
}

sig y {
  value: Int,
  dimensions: seq Int  // [2, 1]
}

// Connection constraints
fact Connections {
  // Connection 1: prior_mean -> x
  some prior_mean and some x
  // Connection 2: F -> x
  some F and some x
  // Connection 3: x -> y
  some x and some y
  // Connection 4: H -> y
  some H and some y
  // Connection 5: Q -> x
  some Q and some x
  // Connection 6: R -> y
  some R and some y
}

// Model validity predicate
pred Predictive_Coding_Active_Inference_AgentValid {
  // All variables must exist
  some x
  some y
  some F
  some H
  some Q
  some R
  some prior_mean
  some prior_cov
  some t
}

// Parameter constraints
fact Parameters {
  // Parameter: F = [[1.0, 0.1], [0.0, 0.8]]
  // Parameter: H = [[1.0, 0.0], [0.0, 1.0]]
  // Parameter: Q = [[0.1, 0.0], [0.0, 0.1]]
  // Parameter: R = [[0.25, 0.0], [0.0, 0.25]]
  // Parameter: prior_mean = [[0.0, 0.0]]
  // Parameter: prior_cov = [[1.0, 0.0], [0.0, 1.0]]
  // Parameter: num_timesteps = 15
  // Parameter: dt = 0.1
  // Parameter: random_seed = 42
  // Parameter: num_states = 2
  // Parameter: num_observations = 2
}


