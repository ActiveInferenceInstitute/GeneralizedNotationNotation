module Dirichlet_Likelihood_Learning_Agent

// GNN Model: Dirichlet Likelihood Learning Agent
// This model describes a discrete POMDP agent that learns its observation model:
// 
// - 3 hidden states, 3 observation outcomes, 2 actions (cycle, stay).
// - The likelihood matrix A is NOT fixed: it is a latent DirichletCollection
//   variable with prior pseudo-counts declared in dirichlet_A.
// - The A values under InitialParameterization are the GROUND-TRUTH likelihood
//   used by the environment to simulate observations; the agent never sees them
//   directly and must recover them in q(A).
// - The Dirichlet prior is identity-biased (diagonal 3.0, off-diagonal 1.0):
//   the agent starts believing observations weakly track states. A fully
//   uniform prior leaves the column-permutation symmetry unbroken and
//   variational inference converges to a label-switched optimum.
// - Transitions B are near-deterministic and known, so states are
//   well-determined by actions and likelihood learning is well-conditioned.
// - Inference: structured VMP with mean-field cut q(s, A) = q(s)q(A),
//   q(A) initialized at the prior counts, q(s) initialized uniform.
// Generated by AlloySerializer

// Variable signatures
sig A {
  value: Int,
  dimensions: seq Int  // [3, 3]
}

sig B {
  value: Int,
  dimensions: seq Int  // [3, 3, 2]
}

sig C {
  value: Int,
  dimensions: seq Int  // [3]
}

sig D {
  value: Int,
  dimensions: seq Int  // [3]
}

sig G {
  value: Int,
  dimensions: seq Int  // [1]
}

sig dirichlet_A {
  value: Int,
  dimensions: seq Int  // [3, 3]
}

sig o {
  value: Int,
  dimensions: seq Int  // [3, 1]
}

sig s {
  value: Int,
  dimensions: seq Int  // [3, 1]
}

sig s_prime {
  value: Int,
  dimensions: seq Int  // [3, 1]
}

sig t {
  value: Int,
  dimensions: seq Int  // [1]
}

sig u {
  value: Int,
  dimensions: seq Int  // [1]
}

sig V_ {
  value: Int,
  dimensions: seq Int  // [2]
}

// Connection constraints
fact Connections {
  // Connection 1: D -> s
  some D and some s
  // Connection 2: s -> A
  some s and some A
  // Connection 3: s -> s_prime
  some s and some s_prime
  // Connection 4: A -> o
  some A and some o
  // Connection 5: s -> B
  some s and some B
  // Connection 6: C -> G
  some C and some G
  // Connection 7: G -> π
  some G and some V_
  // Connection 8: π -> u
  some V_ and some u
  // Connection 9: B -> u
  some B and some u
  // Connection 10: u -> s_prime
  some u and some s_prime
}

// Model validity predicate
pred Dirichlet_Likelihood_Learning_AgentValid {
  // All variables must exist
  some A
  some B
  some C
  some D
  some dirichlet_A
  some s
  some s_prime
  some o
  some V_
  some u
  some G
  some t
}

// Parameter constraints
fact Parameters {
  // Parameter: A = [[0.85, 0.05, 0.1], [0.1, 0.9, 0.05], [0.05, 0.05, 0.85]]
  // Parameter: B = [[[0.1, 0.9], [0.0, 0.05], [0.9, 0.05]], [[0.9, 0.05], [0.1, 0.9], [0.0, 0.05]], [[0.0, 0.05], [0.9, 0.05], [0.1, 0.9]]]
  // Parameter: C = [[0.0, 0.0, 1.0]]
  // Parameter: D = [[1.0, 0.0, 0.0]]
  // Parameter: dirichlet_A = [[3.0, 1.0, 1.0], [1.0, 3.0, 1.0], [1.0, 1.0, 3.0]]
  // Parameter: num_hidden_states = 3
  // Parameter: num_obs = 3
  // Parameter: num_actions = 2
  // Parameter: num_timesteps = 15
  // Parameter: inference_iterations = 40
}


