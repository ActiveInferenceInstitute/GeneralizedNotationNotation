    <parameter name="num_archetypes">4</parameter>
    <parameter name="num_fuel_types">2</parameter>
    <parameter name="num_observations">4</parameter>
    <parameter name="num_regions">1</parameter>
    <parameter name="num_states">2</parameter>
    <parameter name="num_time_slices">12</parameter>
    <parameter name="num_timesteps">24</parameter>
    <parameter name="prior_cov">[[0.02, 0.0], [0.0, 0.02]]</parameter>
    <parameter name="prior_mean">[[0.02, 0.0]]</parameter>
