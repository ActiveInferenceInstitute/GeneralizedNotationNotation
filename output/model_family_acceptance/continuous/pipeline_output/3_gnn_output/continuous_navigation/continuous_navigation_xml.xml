      <targets>u</targets>
    </connection>
    <connection type="directed">
      <sources>goal_mean</sources>
      <targets>u</targets>
    </connection>
    <connection type="directed">
      <sources>prior_mean</sources>
      <targets>x</targets>
    </connection>
    <connection type="directed">
      <sources>u</sources>
      <targets>x</targets>
