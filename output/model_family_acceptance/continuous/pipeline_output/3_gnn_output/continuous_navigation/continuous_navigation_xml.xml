      <targets>y</targets>
    </connection>
  </connections>
  <parameters>
    <parameter name="F">[[1.0, 0.0], [0.0, 1.0]]</parameter>
    <parameter name="H">[[1.0, 0.0], [0.0, 1.0]]</parameter>
    <parameter name="Q">[[0.05, 0.0], [0.0, 0.05]]</parameter>
    <parameter name="R">[[0.1, 0.0], [0.0, 0.1]]</parameter>
    <parameter name="control_gain">[[0.3]]</parameter>
    <parameter name="dt">0.1</parameter>
    <parameter name="goal_mean">[[2.0, 2.0]]</parameter>
    <parameter name="num_observations">2</parameter>
