    <variable data_type="float" dimensions="2,2" name="H" type="hidden_state" description="observation matrix"/>
    <variable data_type="float" dimensions="2,2" name="Q" type="hidden_state" description="process-noise covariance"/>
    <variable data_type="float" dimensions="2,2" name="R" type="hidden_state" description="observation-noise covariance"/>
    <variable data_type="float" dimensions="1" name="control_gain" type="action" description="scalar proportional gain"/>
    <variable data_type="float" dimensions="2" name="goal_mean" type="hidden_state" description="preferred state (goal)"/>
    <variable data_type="float" dimensions="2,2" name="prior_cov" type="prior_vector" description="prior covariance over the initial latent state"/>
    <variable data_type="float" dimensions="2" name="prior_mean" type="prior_vector" description="prior mean over the initial latent state"/>
    <variable data_type="integer" dimensions="1" name="t" type="hidden_state" description="discrete time step"/>
    <variable data_type="float" dimensions="2,1" name="u" type="action" description="control input"/>
    <variable data_type="float" dimensions="2,1" name="x" type="hidden_state" description="continuous latent state"/>
    <variable data_type="float" dimensions="2,1" name="y" type="hidden_state" description="continuous observation"/>
  </variables>
