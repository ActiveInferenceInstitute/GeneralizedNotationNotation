    "ModelParameters": "num_hidden_states: 16\nnum_obs: 16\nnum_actions: 3\nnum_agents: 2\nnum_hidden_states_per_agent: 4\nnum_obs_per_agent: 4\nnum_actions_per_agent: 3\nnum_timesteps: 20",
