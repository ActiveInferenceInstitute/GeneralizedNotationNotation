module Continuous_State_Navigation_Agent

// GNN Model: Continuous State Navigation Agent
// A continuous-state Active Inference navigation agent rendered as a native
// linear-Gaussian state-space model (LGSSM):
// - Hidden state x = (x, y): the continuous 2D position of the navigator.
// - Observation y: noisy readings of the 2D position (identity readout).
// - Control input u: a goal-seeking command added to the state each step.
// - The controller closes the loop on beliefs — it pushes the filtered posterior
//   mean toward the preferred position goal_mean = (2.0, 2.0) with proportional
//   gain control_gain = 0.3, i.e. u_t = control_gain * (goal_mean - mu_t).
// Generated by AlloySerializer

// Variable signatures
sig F {
  value: Int,
  dimensions: seq Int  // [2, 2]
}

sig H {
  value: Int,
  dimensions: seq Int  // [2, 2]
}

sig Q {
  value: Int,
  dimensions: seq Int  // [2, 2]
}

sig R {
  value: Int,
  dimensions: seq Int  // [2, 2]
}

sig control_gain {
  value: Int,
  dimensions: seq Int  // [1]
}

sig goal_mean {
  value: Int,
  dimensions: seq Int  // [2]
}

sig prior_cov {
  value: Int,
  dimensions: seq Int  // [2, 2]
}

sig prior_mean {
  value: Int,
  dimensions: seq Int  // [2]
}

sig t {
  value: Int,
  dimensions: seq Int  // [1]
}

sig u {
  value: Int,
  dimensions: seq Int  // [2, 1]
}

sig x {
  value: Int,
  dimensions: seq Int  // [2, 1]
}

sig y {
  value: Int,
  dimensions: seq Int  // [2, 1]
}

// Connection constraints
fact Connections {
  // Connection 1: prior_mean -> x
  some prior_mean and some x
  // Connection 2: F -> x
  some F and some x
  // Connection 3: x -> y
  some x and some y
  // Connection 4: H -> y
  some H and some y
  // Connection 5: Q -> x
  some Q and some x
  // Connection 6: R -> y
  some R and some y
  // Connection 7: u -> x
  some u and some x
  // Connection 8: goal_mean -> u
  some goal_mean and some u
  // Connection 9: control_gain -> u
  some control_gain and some u
}

// Model validity predicate
pred Continuous_State_Navigation_AgentValid {
  // All variables must exist
  some x
  some y
  some u
  some F
  some H
  some Q
  some R
  some prior_mean
  some prior_cov
  some goal_mean
  some control_gain
  some t
}

// Parameter constraints
fact Parameters {
  // Parameter: F = [[1.0, 0.0], [0.0, 1.0]]
  // Parameter: H = [[1.0, 0.0], [0.0, 1.0]]
  // Parameter: Q = [[0.05, 0.0], [0.0, 0.05]]
  // Parameter: R = [[0.1, 0.0], [0.0, 0.1]]
  // Parameter: prior_mean = [[0.0, 0.0]]
