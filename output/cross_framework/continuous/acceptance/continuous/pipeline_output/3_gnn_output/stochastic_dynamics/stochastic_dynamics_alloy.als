module Stochastic_Continuous_Dynamics_Agent

// GNN Model: Stochastic Continuous Dynamics Agent
// A continuous-state Active Inference agent whose dynamics carry explicit process
// and observation noise, rendered as a native linear-Gaussian state-space model
// (LGSSM). The agent runs passively — it has no control input:
// - Hidden state x = (position, velocity): the Euler-discretized (dt = 0.1) SDE.
// - Observation y: two noisy readouts, both reading the position.
// - Q is the process-noise covariance (inverse process precision); R is the
//   observation-noise covariance (inverse observation precision).
// Generated by AlloySerializer

// Variable signatures
sig F {
  value: Int,
  dimensions: seq Int  // [2, 2]
}

sig H {
  value: Int,
  dimensions: seq Int  // [2, 2]
}

sig Q {
  value: Int,
  dimensions: seq Int  // [2, 2]
}

sig R {
  value: Int,
  dimensions: seq Int  // [2, 2]
}

sig prior_cov {
  value: Int,
  dimensions: seq Int  // [2, 2]
}

sig prior_mean {
  value: Int,
  dimensions: seq Int  // [2]
}

sig t {
  value: Int,
  dimensions: seq Int  // [1]
}

sig x {
  value: Int,
  dimensions: seq Int  // [2, 1]
}

sig y {
  value: Int,
  dimensions: seq Int  // [2, 1]
}

// Connection constraints
fact Connections {
  // Connection 1: prior_mean -> x
  some prior_mean and some x
  // Connection 2: F -> x
  some F and some x
  // Connection 3: x -> y
  some x and some y
  // Connection 4: H -> y
  some H and some y
  // Connection 5: Q -> x
  some Q and some x
  // Connection 6: R -> y
  some R and some y
}

// Model validity predicate
pred Stochastic_Continuous_Dynamics_AgentValid {
  // All variables must exist
  some x
  some y
  some F
  some H
  some Q
  some R
  some prior_mean
  some prior_cov
  some t
}

// Parameter constraints
fact Parameters {
  // Parameter: F = [[1.0, 0.1], [0.0, 0.9]]
  // Parameter: H = [[1.0, 0.0], [1.0, 0.0]]
  // Parameter: Q = [[0.1, 0.0], [0.0, 0.1]]
  // Parameter: R = [[0.2, 0.0], [0.0, 0.2]]
  // Parameter: prior_mean = [[0.0, 0.0]]
  // Parameter: prior_cov = [[0.5, 0.0], [0.0, 1.0]]
  // Parameter: num_timesteps = 15
  // Parameter: dt = 0.1
  // Parameter: random_seed = 42
  // Parameter: num_states = 2
  // Parameter: num_observations = 2
}


