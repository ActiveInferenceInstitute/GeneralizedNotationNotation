      <targets>y</targets>
    </connection>
  </connections>
  <parameters>
    <parameter name="F">[[1.0, 0.1], [0.0, 0.9]]</parameter>
    <parameter name="H">[[1.0, 0.0], [1.0, 0.0]]</parameter>
    <parameter name="Q">[[0.1, 0.0], [0.0, 0.1]]</parameter>
    <parameter name="R">[[0.2, 0.0], [0.0, 0.2]]</parameter>
    <parameter name="dt">0.1</parameter>
    <parameter name="num_observations">2</parameter>
    <parameter name="num_states">2</parameter>
    <parameter name="num_timesteps">15</parameter>
    <parameter name="prior_cov">[[0.5, 0.0], [0.0, 1.0]]</parameter>
    <parameter name="prior_mean">[[0.0, 0.0]]</parameter>
    <parameter name="random_seed">42</parameter>
  </parameters>
  <time_specification horizon="15" type="Dynamic"/>
